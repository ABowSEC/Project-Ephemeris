# Security headers for Cloudflare Pages. Non-obvious CSP entries:
#   'wasm-unsafe-eval'      - needed to load the orbital WebAssembly module
#                             (doesn't allow eval or inline script)
#   style 'unsafe-inline'   - Chakra/Emotion inject styles at runtime
#   img-src https:          - mission images come from many CDNs
#   worker-src blob:        - MapLibre's worker
#   frame-src youtube/vimeo - ISS feed and APOD videos
#   cloudflareinsights.com  - Cloudflare injects its analytics beacon
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://ll.thespacedevs.com https://science.nasa.gov https://images-api.nasa.gov https://api.wheretheiss.at https://tiles.openfreemap.org https://cloudflareinsights.com; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'

# Hashed build assets are immutable: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate so updates roll out. No CSP here: it would apply to the
# worker's own fetches and block caching cross-origin images and fonts.
/sw.js
  Cache-Control: no-cache
  ! Content-Security-Policy
