{
  // Incremental TypeScript adoption. Remaining .js/.jsx files keep resolving
  // through allowJs, and checkJs: false means tsc never reports on them. A
  // file is converted whole, to .ts/.tsx under full strict, when it is next
  // substantially changed, so the type boundary moves file by file rather
  // than sprawling into half-typed modules.
  //
  // functions/ is excluded here — Pages Functions run on the Workers runtime,
  // not the DOM, and have their own tsconfig with @cloudflare/workers-types.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "functions", "src/wasm"]
}
